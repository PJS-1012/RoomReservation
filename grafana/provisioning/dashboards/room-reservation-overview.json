{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/reservations\",method=\"POST\"}[1m]))", "legendFormat": "requests" }
      ],
      "title": "Reservation Create Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/reservations\",method=\"POST\"}[1m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/reservations\",method=\"POST\"}[1m])))", "legendFormat": "p99" }
      ],
      "title": "Reservation Create Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        { "expr": "sum by (instance) (hikaricp_connections_active)", "legendFormat": "{{instance}} active" },
        { "expr": "sum by (instance) (hikaricp_connections_pending)", "legendFormat": "{{instance}} pending" }
      ],
      "title": "HikariCP Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{instance}} heap" },
        { "expr": "redis_memory_used_bytes", "legendFormat": "redis" }
      ],
      "title": "JVM Heap and Redis Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        { "expr": "sum by (outcome) (increase(reservation_lock_requests_total[1m]))", "legendFormat": "{{outcome}}" }
      ],
      "title": "Redis Reservation Lock Outcomes",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["room-reservation", "redis", "monitoring"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Room Reservation Overview",
  "uid": "room-reservation-overview",
  "version": 1
}
